{
  "name": "prolog-tester",
  "displayName": "Prolog Tests",
  "description": "A VS Code extension which adds support for Prolog unit tests to the VS Code test explorer.",
  "version": "1.1.1",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Testing"
  ],
  "pricing": "Free",
  "author": {
    "name": "Bennet Krzenzck",
    "email": "bennetkrzenzck@t-online.de"
  },
  "activationEvents": [
    "onLanguage:prolog"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "prolog",
        "aliases": [
          "Prolog",
          "swipl",
          "SWIP-Prolog"
        ],
        "extensions": [
          ".pl",
          ".plt"
        ],
        "configuration": ""
      }
    ],
    "configuration": {
      "title": "Prolog Tests",
      "properties": {
        "prologtests.testFileExtesions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".pl",
            ".plt"
          ],
          "description": "What filetypes should be seen as test files."
        },
        "prologtests.sipExecutablePath": {
          "type": "string",
          "default": null,
          "description": "The path to the executable of SWIP to execute the tests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BennetKrz/prolog-tester/issues/new",
    "email": "bennetkrzenzck@t-online.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BennetKrz/prolog-tester"
  },
  "publisher": "BennetKrzenzck",
  "icon": "logo.png",
  "homepage": "https://github.com/BennetKrz/prolog-tester"
}
